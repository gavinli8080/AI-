# Gavin 24h 定制版
TELEGRAM_BOT_TOKEN=your_token
TELEGRAM_CHAT_ID=your_chat_id

BINANCE_ENABLED=true
OKX_ENABLED=true
BITGET_ENABLED=true
GATE_ENABLED=true
BYBIT_ENABLED=true
DEXSCREENER_ENABLED=true
DEX_CHAINS=solana,base,ethereum,bsc
DEX_MIN_LIQUIDITY=80000
DEX_MIN_POOL_AGE_HOURS=48
DEX_MIN_TXNS_1H=80

SCAN_INTERVAL=60
SCORING_MODE=strict
MIN_24H_TURNOVER=600000
MIN_1H_TURNOVER=80000
MAX_CHANGE_1H=35
MAX_DAILY_PUSHES=24
PUSH_MIN_SCORE=50

MAIN_PUSH_COOLDOWN=1800
WATCHLIST_COOLDOWN=900
COOLDOWN_PHASE_RESET=true
COOLDOWN_PRICE_RESET_PCT=2.0
COOLDOWN_SCORE_JUMP_RESET=10.0

WATCHLIST_ENABLED=true
WATCHLIST_MIN_SCORE=28
MAX_DAILY_WATCHLIST=20
WATCHLIST_TURNOVER_MULT=0.6
WATCHLIST_FINE_CHANGE_MULT=0.75

ADAPTIVE_ENABLED=true
ADAPTIVE_LOOKBACK_CYCLES=20
ADAPTIVE_MIN_SIGNALS=2
ADAPTIVE_WATCHLIST_RELAX=4.0
ADAPTIVE_FINE_CHANGE_RELAX=0.85

VOL_RATIO_WARNING=12.0
VOL_RATIO_HEAVY=20.0
VOL_RATIO_REJECT=35.0
VOL_RATIO_EXTREME=50.0

PUSH_WATCHLIST_ON_EMPTY=true
EMPTY_MAIN_WL_COUNT=4

WHITELIST=BTC,ETH,TAO,RNDR,NEAR,FET,VIRTUAL,AIXBT
BLACKLIST=

DB_PATH=data/radar.db
LOG_LEVEL=INFO
LOG_FILE=data/radar.log
HTTP_TIMEOUT=15
PRICE_DEVIATION_THRESHOLD=2.5
MARKET_CACHE_TTL=1800
ENABLE_PRICE_VERIFICATION=true

MAIN_REQUIRE_POSITIVE_1H=true
MAIN_REQUIRE_POSITIVE_4H=true
MAIN_MAX_24H_CHANGE=18.0
MAIN_MAX_1H_CHANGE=8.5
MAIN_MIN_TURNOVER_24H=1000000
MAIN_MIN_TURNOVER_1H=120000
LEVERAGE_WATCHLIST_ONLY=true
LEVERAGE_ALLOWLIST=
WATCHLIST_REJECT_IF_24H_OVERHEAT=28.0

# V2.9: 推送前复核（推送前重新拉取实时价，偏差过大则降级）
RECHECK_ENABLED=true
RECHECK_MAX_DEVIATION_PCT=3.0

# V2.9: 跨交易所去重（同币多交易所只保留最优版本）
CROSS_EXCHANGE_DEDUP_ENABLED=true

# V2.9: 脉冲/假突破过滤加强
PULSE_5M_CHANGE_THRESHOLD=5.0
PULSE_5M_1H_MAX=2.0
FAKE_BREAKOUT_5M_MIN=3.0
TAIL_SURGE_24H_MIN=10.0

# V2.9.1: 24h区间位置（接近24h高点=上方空间不足）
HIGH_POSITION_REJECT_THRESHOLD=0.92
HIGH_POSITION_DEMOTE_THRESHOLD=0.85

# V2.9.1: 弱修复/死猫跳过滤（24h跌+1h微涨+量不足=无力反弹）
WEAK_REPAIR_MAX_1H=2.0
WEAK_REPAIR_MAX_4H=1.5
WEAK_REPAIR_MIN_VR5M=1.8

# V2.9.1: 观察池收紧
WATCHLIST_MIN_SCORE_STRICT=35.0
WATCHLIST_REQUIRE_POSITIVE_1H=true
MAX_DAILY_WATCHLIST_STRICT=5

# V2.9.1: 大盘环境过滤（BTC/ETH弱势时提高门槛）
MARKET_REGIME_ENABLED=true
MARKET_REGIME_BEARISH_PUSH_MIN_SCORE=65.0
MARKET_REGIME_BEARISH_WL_MIN_SCORE=45.0

# V2.9.2: 唯一一单模式（一天最多一枪，宁缺毋滥）
SINGLE_BEST_MODE=true
SINGLE_BEST_MAX_PUSH=1
SINGLE_BEST_MIN_SCORE=58.0
SINGLE_BEST_CONFIDENCE_GAP=8.0
SINGLE_BEST_WEAK_THRESHOLD=62.0

# V2.9.1: 量比不一致惩罚（5m量比高但15m不跟=单根异常）
VOL_RATIO_INCONSISTENCY_PENALTY=true

# V2.9.1: 观察池复核偏差阈值
WL_RECHECK_MAX_DEVIATION_PCT=2.5

# V2.9.2: 允许空轮（宁可无信号也不推垃圾）
STRICT_EMPTY_ROUND_ALLOWED=true

# V2.9.2: fallback门槛
FALLBACK_MIN_SCORE=42.0
FALLBACK_MIN_TURNOVER_24H=800000

# V2.9.2: 大盘弱时小所降级
MARKET_REGIME_BEARISH_DEMOTE_MINOR_SOURCES=true
MARKET_REGIME_NEUTRAL_MIN_TURNOVER_24H=1500000

# V2.9.2: 观察池流动性门槛
WATCHLIST_MIN_TURNOVER_24H=500000
