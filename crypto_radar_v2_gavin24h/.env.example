# Gavin 24h 定制版 — V3.0 保守默认值
# 唯一目标: 24小时短线唯一实盘单筛选器, 宁可空仓不乱做
TELEGRAM_BOT_TOKEN=your_token
TELEGRAM_CHAT_ID=your_chat_id

BINANCE_ENABLED=true
OKX_ENABLED=true
BITGET_ENABLED=true
GATE_ENABLED=true
BYBIT_ENABLED=true
DEXSCREENER_ENABLED=true
DEX_CHAINS=solana,base,ethereum,bsc
DEX_MIN_LIQUIDITY=80000
DEX_MIN_POOL_AGE_HOURS=48
DEX_MIN_TXNS_1H=80

SCAN_INTERVAL=60
SCORING_MODE=strict
MIN_24H_TURNOVER=600000
MIN_1H_TURNOVER=80000
MAX_CHANGE_1H=35
MAX_DAILY_PUSHES=24
PUSH_MIN_SCORE=58

MAIN_PUSH_COOLDOWN=1800
WATCHLIST_COOLDOWN=900
COOLDOWN_PHASE_RESET=true
COOLDOWN_PRICE_RESET_PCT=2.0
COOLDOWN_SCORE_JUMP_RESET=10.0

WATCHLIST_ENABLED=true
WATCHLIST_MIN_SCORE=28
MAX_DAILY_WATCHLIST=20
WATCHLIST_TURNOVER_MULT=0.6
WATCHLIST_FINE_CHANGE_MULT=0.75

ADAPTIVE_ENABLED=true
ADAPTIVE_LOOKBACK_CYCLES=20
ADAPTIVE_MIN_SIGNALS=2
ADAPTIVE_WATCHLIST_RELAX=4.0
ADAPTIVE_FINE_CHANGE_RELAX=0.85

VOL_RATIO_WARNING=12.0
VOL_RATIO_HEAVY=20.0
VOL_RATIO_REJECT=35.0
VOL_RATIO_EXTREME=50.0

# V3.0: 空轮时不推观察池凑数
PUSH_WATCHLIST_ON_EMPTY=false
EMPTY_MAIN_WL_COUNT=1

WHITELIST=BTC,ETH,TAO,RNDR,NEAR,FET,VIRTUAL,AIXBT
BLACKLIST=

DB_PATH=data/radar.db
LOG_LEVEL=INFO
LOG_FILE=data/radar.log
HTTP_TIMEOUT=15
PRICE_DEVIATION_THRESHOLD=2.5
MARKET_CACHE_TTL=1800
ENABLE_PRICE_VERIFICATION=true

# 24h短线主推硬门槛
MAIN_REQUIRE_POSITIVE_1H=true
MAIN_REQUIRE_POSITIVE_4H=true
MAIN_MAX_24H_CHANGE=18.0
MAIN_MAX_1H_CHANGE=8.5
MAIN_MIN_TURNOVER_24H=1500000
MAIN_MIN_TURNOVER_1H=120000
LEVERAGE_WATCHLIST_ONLY=true
LEVERAGE_ALLOWLIST=
WATCHLIST_REJECT_IF_24H_OVERHEAT=28.0

# V2.9: 推送前复核
RECHECK_ENABLED=true
RECHECK_MAX_DEVIATION_PCT=3.0

# V2.9: 跨交易所去重
CROSS_EXCHANGE_DEDUP_ENABLED=true

# V2.9: 脉冲/假突破过滤
PULSE_5M_CHANGE_THRESHOLD=5.0
PULSE_5M_1H_MAX=2.0
FAKE_BREAKOUT_5M_MIN=3.0
TAIL_SURGE_24H_MIN=10.0

# V3.0: 24h区间位置硬门槛 (主推/fallback/观察池各有上限)
MAIN_MAX_POSITION_IN_24H_RANGE=0.62
HIGH_POSITION_REJECT_THRESHOLD=0.92
HIGH_POSITION_DEMOTE_THRESHOLD=0.85
FALLBACK_MAX_POSITION_IN_24H_RANGE=0.55
WATCHLIST_MAX_POSITION_IN_24H_RANGE=0.68
LOW_POSITION_REPAIR_BONUS_ENABLED=true
HIGH_POSITION_BOUNCE_PENALTY_ENABLED=true

# V3.0: 三级修复检测 (弱修复/慢修复/无量修复)
WEAK_REPAIR_MAX_1H=2.0
WEAK_REPAIR_MAX_4H=1.5
WEAK_REPAIR_MIN_VR5M=1.8
SLOW_REPAIR_MIN_1H_CHANGE=3.0
SLOW_REPAIR_MIN_4H_CHANGE=4.0
SLOW_REPAIR_MIN_TURNOVER_1H=100000

# V3.0: 观察池=监控池 (严格收紧, 不是备选池)
WATCHLIST_MIN_SCORE_STRICT=40.0
WATCHLIST_REQUIRE_POSITIVE_1H=true
MAX_DAILY_WATCHLIST_STRICT=3
WATCHLIST_MIN_TURNOVER_24H=500000
WATCHLIST_REJECT_SLOW_REPAIR=true
WATCHLIST_REJECT_NO_VOLUME_REPAIR=true
WATCHLIST_REJECT_HIGH_POSITION_BOUNCE=true
WATCHLIST_REQUIRE_REAL_CONTINUATION=true

# V3.0: 大盘环境4级 (bullish/neutral/weak_neutral/bearish)
MARKET_REGIME_ENABLED=true
MARKET_REGIME_BEARISH_PUSH_MIN_SCORE=70.0
MARKET_REGIME_BEARISH_WL_MIN_SCORE=50.0
BEARISH_DISABLE_SMALL_CAP_MAIN=true
BEARISH_DISABLE_FALLBACK=true
BEARISH_STRICT_WATCHLIST=true
WEAK_NEUTRAL_STRICT_MAIN=true
WEAK_NEUTRAL_STRICT_WATCHLIST=true
WEAK_NEUTRAL_MIN_TURNOVER_24H=2000000

# V3.0: 唯一一单模式 (一天最多一枪, 宁缺毋滥)
SINGLE_BEST_MODE=true
SINGLE_BEST_MAX_PUSH=1
SINGLE_BEST_MIN_SCORE=60.0
SINGLE_BEST_MIN_EDGE=6.0
SINGLE_BEST_REQUIRE_CLEAR_WIN=true

# V3.0: 量比一致性 + 纯15m脉冲拒绝
VOL_RATIO_INCONSISTENCY_PENALTY=true
PURE_15M_PULSE_REJECT_MAIN=true

# V3.0: 观察池复核偏差
WL_RECHECK_MAX_DEVIATION_PCT=2.5

# V3.0: 允许空轮 (宁可无信号也不推垃圾)
STRICT_EMPTY_ROUND_ALLOWED=true

# V3.0: fallback (几乎不用, 门槛极高)
FALLBACK_MIN_SCORE=58.0
FALLBACK_MIN_TURNOVER_24H=1500000
FALLBACK_MIN_TURNOVER_1H=120000
FALLBACK_MAX_24H_CHANGE=18.0
FALLBACK_REJECT_SLOW_REPAIR=true
FALLBACK_REJECT_HIGH_POSITION=true
FALLBACK_REJECT_SMALL_EXCHANGE_NOISE=true
